[Unit]
Description=DevFluency Rust service (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=devfluency
Group=devfluency
WorkingDirectory=/opt/apps/plataforma-aprendizaje/current
EnvironmentFile=/etc/apps/plataforma-aprendizaje/plataforma-aprendizaje.env
# Instance-specific settings are loaded only by their matching service.
# In particular, only phonetic-audio-service receives its Cloudflare TTS token.
EnvironmentFile=-/etc/apps/plataforma-aprendizaje/%i.env
Environment=RUST_LOG=info
ExecStart=/opt/apps/plataforma-aprendizaje/current/bin/%i
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devfluency
UMask=0027

[Install]
WantedBy=devfluency.target
