# DevFluency: configuración local de ejemplo.
# Copia este archivo a .env y configura las credenciales antes de iniciar los servicios.
# No reutilices secretos entre entornos. Los campos vacíos son obligatorios cuando aplica.

# PostgreSQL
POSTGRES_USER=devfluency_user
POSTGRES_PASSWORD=
POSTGRES_DB=devfluency_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Construye esta URL con el mismo usuario y contraseña configurados arriba.
DATABASE_URL=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# NATS JetStream
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_USERNAME=nats_admin
NATS_PASSWORD=
NATS_URL=

# JWT: genera un secreto aleatorio de al menos 32 bytes para desarrollo.
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# AWS: se recomienda el proveedor de credenciales del entorno (perfil/rol).
# No descomentes estas variables salvo que realmente necesites usar claves de entorno.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_POLLY_VOICE_ID=Matthew
AWS_TRANSCRIBE_LANGUAGE_CODE=en-US

# Puertos y servicios gRPC / HTTP
BFF_HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
BFF_HTTP_BIND_ADDR=127.0.0.1:8080
AUTH_SERVICE_BIND_ADDR=127.0.0.1:50051
CONTENT_SERVICE_BIND_ADDR=127.0.0.1:50052
AI_SERVICE_BIND_ADDR=127.0.0.1:50053
PHONETIC_SERVICE_BIND_ADDR=127.0.0.1:50054
SRS_SERVICE_BIND_ADDR=127.0.0.1:50055
GAMIFICATION_SERVICE_BIND_ADDR=127.0.0.1:50056
AUTH_SERVICE_GRPC_URL=http://127.0.0.1:50051
CONTENT_SERVICE_GRPC_URL=http://127.0.0.1:50052
AI_SERVICE_GRPC_URL=http://127.0.0.1:50053
PHONETIC_SERVICE_GRPC_URL=http://127.0.0.1:50054
SRS_SERVICE_GRPC_URL=http://127.0.0.1:50055
GAMIFICATION_SERVICE_GRPC_URL=http://127.0.0.1:50056
