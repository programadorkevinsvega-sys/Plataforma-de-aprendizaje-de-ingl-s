# ------------------------------------------------------------------------------
# 🐘 BASE DE DATOS POSTGRESQL 16 (MULTI-TENANT CON ROW LEVEL SECURITY - RLS)
# ------------------------------------------------------------------------------
POSTGRES_USER=devfluency_user
POSTGRES_PASSWORD=devfluency_secure_password_2026
POSTGRES_DB=devfluency_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgres://devfluency_user:devfluency_secure_password_2026@127.0.0.1:5432/devfluency_db

# ------------------------------------------------------------------------------
# 🔴 CACHÉ & ESTADO CON REDIS 7.2
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_password_2026
REDIS_URL=redis://:redis_secret_password_2026@127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# ⚡ BUS DE EVENTOS CON NATS JETSTREAM
# ------------------------------------------------------------------------------
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_URL=nats://127.0.0.1:4222

# ------------------------------------------------------------------------------
# 🔐 SEGURIDAD & TOKENS JWT
# ------------------------------------------------------------------------------
JWT_SECRET=devfluency_super_secret_jwt_key_2026_enterprise_production
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# ☁️ AWS CLOUD AI (BEDROCK, TRANSCRIBE & POLLY)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=TU_AWS_ACCESS_KEY_ID_AQUI
AWS_SECRET_ACCESS_KEY=TU_AWS_SECRET_ACCESS_KEY_AQUI

# IA de Texto (AWS Bedrock Runtime - Claude 3.5 Sonnet / Titan)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# IA de Audio TTS (AWS Polly Neural Voices)
