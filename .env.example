# DevFluency: configuración local de ejemplo.
# Copia este archivo a .env y configura las credenciales antes de iniciar los servicios.
# No reutilices secretos entre entornos. Los campos vacíos son obligatorios cuando aplica.

# PostgreSQL
POSTGRES_USER=devfluency_user
POSTGRES_PASSWORD=
POSTGRES_DB=devfluency_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Construye esta URL con el mismo usuario y contraseña configurados arriba.
DATABASE_URL=
# Maximum wait for a PostgreSQL pool connection; positive integer, 1-30 seconds.
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# NATS JetStream
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_USERNAME=nats_admin
NATS_PASSWORD=
NATS_URL=

# JWT: genera un secreto aleatorio de al menos 32 bytes para desarrollo.
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# TTS: selection is loaded by phonetic-audio-service at process startup.
# Supported: aws (default) or cloudflare. No provider fallback is performed.
TTS_PROVIDER=aws

# Cloudflare Workers AI — required only when TTS_PROVIDER=cloudflare.
# CLOUDFLARE_ACCOUNT_ID is the 32-character Account ID, not the Zone ID.
# Use the Cloudflare Workers AI API Token template, or grant Workers AI Read and Workers AI Edit; never commit it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TTS_MODEL_EN=@cf/deepgram/aura-2-en
CLOUDFLARE_TTS_MODEL_ES=@cf/deepgram/aura-2-es
CLOUDFLARE_TTS_SPEAKER_EN=luna
CLOUDFLARE_TTS_SPEAKER_ES=aquila
CLOUDFLARE_TTS_TIMEOUT_SECONDS=30

# AWS: se recomienda el proveedor de credenciales del entorno (perfil/rol).
# No descomentes estas variables salvo que realmente necesites usar claves de entorno.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Bounded AWS SDK credential/region resolution used by Polly and Transcribe WebSocket startup.
AWS_CONFIG_LOAD_TIMEOUT_SECONDS=10
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Total time allowed for Bedrock config loading plus one evaluation operation (1-300 seconds).
AWS_BEDROCK_TIMEOUT_SECONDS=60
AWS_POLLY_VOICE_ID=Matthew
AWS_POLLY_TIMEOUT_SECONDS=30
AWS_TRANSCRIBE_LANGUAGE_CODE=en-US
# Total timeout for unary AWS Transcribe operations, including config load and stream receive.
AWS_TRANSCRIBE_TIMEOUT_SECONDS=45

# Puertos y servicios gRPC / HTTP
BFF_HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
BFF_HTTP_BIND_ADDR=127.0.0.1:8080
AUTH_SERVICE_BIND_ADDR=127.0.0.1:50051
CONTENT_SERVICE_BIND_ADDR=127.0.0.1:50052
AI_SERVICE_BIND_ADDR=127.0.0.1:50053
PHONETIC_SERVICE_BIND_ADDR=127.0.0.1:50054
SRS_SERVICE_BIND_ADDR=127.0.0.1:50055
GAMIFICATION_SERVICE_BIND_ADDR=127.0.0.1:50056
AUTH_SERVICE_GRPC_URL=http://127.0.0.1:50051
CONTENT_SERVICE_GRPC_URL=http://127.0.0.1:50052
AI_SERVICE_GRPC_URL=http://127.0.0.1:50053
PHONETIC_SERVICE_GRPC_URL=http://127.0.0.1:50054
SRS_SERVICE_GRPC_URL=http://127.0.0.1:50055
GAMIFICATION_SERVICE_GRPC_URL=http://127.0.0.1:50056

# BFF gRPC connection and per-service operation deadlines (positive seconds).
GRPC_CONNECT_TIMEOUT_SECONDS=3
GRPC_AUTH_DEADLINE_SECONDS=10
GRPC_CONTENT_DEADLINE_SECONDS=45
GRPC_AI_DEADLINE_SECONDS=75
GRPC_SRS_DEADLINE_SECONDS=10
GRPC_AUDIO_DEADLINE_SECONDS=45
GRPC_GAMIFICATION_DEADLINE_SECONDS=10
