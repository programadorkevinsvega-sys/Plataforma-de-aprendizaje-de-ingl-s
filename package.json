{
  "name": "devfluency-node-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "pnpm --filter devfluency-frontend dev",
    "build": "pnpm --filter devfluency-frontend build",
    "start": "pnpm --filter devfluency-frontend start",
    "lint": "pnpm --filter devfluency-frontend lint",
    "test:frontend:phase0": "node --experimental-test-coverage --experimental-loader ./frontend/tests/phase0/ts-path-loader.mjs --test-coverage-include='frontend/src/domain/**/*.ts' --test-coverage-include='frontend/src/application/**/*.ts' --test-coverage-include='frontend/src/infrastructure/**/*.ts' --test-coverage-include='frontend/src/shared/**/*.ts' --test frontend/tests/phase0/*.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
